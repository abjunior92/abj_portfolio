---
import "@fontsource-variable/familjen-grotesk/wght.css";
import "../styles/global.css";
import "../styles/page.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const site = "https://abjportfolio.netlify.app";
const canonical = new URL(Astro.url.pathname, site).href;
const image = new URL("/presentation.png", site).href;
const analyticsId = process.env.GOOGLE_ANALYTICS_ID;
---

<html lang="en">
  <head>
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var theme =
            stored === "light" || stored === "dark"
              ? stored
              : matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          document.documentElement.dataset.theme = theme;
        } catch (error) {}
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Andrea Junior Berselli" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/rick_sanchez_avatar.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta
      name="google-site-verification"
      content="uKWb6x3jOGOyfwL9_P4sHu6sUXsMW5vpX6KmNEOWWSs"
    />
    {
      analyticsId && (
        <script
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`}
        />
      )
    }
    {
      analyticsId && (
        <script is:inline define:vars={{ analyticsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag("js", new Date());
          gtag("config", analyticsId);
        </script>
      )
    }
  </head>
  <body>
    <!--
    THESIS: A centered curriculum on paper, with PlayStation button marks turning slowly behind it. The ink basin is gone.
    OWN-WORLD: Paper #f7f4ee, carbon text #141414, Familjen Grotesk. Outlined marks only: cross #0072ce, square #e04b8a, circle #e10600, triangle #00a34a.
    STORY: A recruiter and a peer read the real facts in one column and reach contact without searching. The marks stay quiet enough that the words win.
    FIRST VIEWPORT: The name leads a centered column. Marks sit fixed in the background, mostly toward the edges, each rotating in place.
    FORM: Classic single column with a background field of controller glyphs.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <slot />
    <script>
      import { resolveTheme } from "../data/theme";

      const storageKey = "theme";
      const root = document.documentElement;
      const media = matchMedia("(prefers-color-scheme: dark)");
      const toggle = document.querySelector("[data-theme-toggle]");

      function readStored() {
        try {
          return localStorage.getItem(storageKey);
        } catch {
          return null;
        }
      }

      function apply(theme: "light" | "dark") {
        root.dataset.theme = theme;
      }

      apply(resolveTheme(readStored(), media.matches));

      media.addEventListener("change", () => {
        const stored = readStored();
        if (stored === "light" || stored === "dark") return;
        apply(resolveTheme(null, media.matches));
      });

      toggle?.addEventListener("click", () => {
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        try {
          localStorage.setItem(storageKey, next);
        } catch {
          /* la scelta resta valida per questa visita */
        }
        apply(next);
      });
    </script>
  </body>
</html>
