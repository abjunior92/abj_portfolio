---
import {
  IconBallBasketball,
  IconBrandFacebook,
  IconBrandGithub,
  IconBrandInstagram,
  IconBrandLinkedin,
  IconBrandTelegram,
  IconBrandWhatsapp,
  IconChevronLeft,
  IconChevronRight,
  IconCode,
  IconMail,
  IconMapPin,
  IconMenu2,
  IconMoon,
  IconSun,
  IconX
} from "@tabler/icons-astro";
import Layout from "../layouts/Layout.astro";
import { loadGithubActivity, toWeekColumns } from "../data/github";
import { profile } from "../data/profile";
import { skillIcon } from "../data/skill-icons";

const year = new Date().getFullYear();

function postDate(iso: string) {
  const [y, m, d] = iso.split("-").map(Number);
  return new Intl.DateTimeFormat("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  }).format(new Date(Date.UTC(y, m - 1, d)));
}

let activity: Awaited<ReturnType<typeof loadGithubActivity>> | null = null;
try {
  activity = await loadGithubActivity(profile.github.label);
} catch (error) {
  const message = error instanceof Error ? error.message : "unknown error";
  console.error(`GitHub activity unavailable: ${message}`);
  activity = null;
}

const columns = activity ? toWeekColumns(activity.days) : [];
const counts = [
  activity?.contributionsYear != null
    ? { value: activity.contributionsYear, label: "contributions in the last year" }
    : null,
  activity?.publicCommits != null
    ? { value: activity.publicCommits, label: "public commits" }
    : null,
  activity?.publicPullRequests != null
    ? { value: activity.publicPullRequests, label: "pull requests" }
    : null,
  activity?.publicRepos != null
    ? { value: activity.publicRepos, label: "repositories" }
    : null
].filter((item) => item !== null);

const firstDay = activity?.days[0]?.date;
const lastDay = activity?.days.at(-1)?.date;
const range =
  firstDay && lastDay
    ? `${formatMonth(firstDay)} – ${formatMonth(lastDay)}`
    : null;

function formatMonth(iso: string) {
  return new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-GB", {
    month: "short",
    year: "numeric",
    timeZone: "UTC"
  });
}

const contactIcons = {
  Email: IconMail,
  LinkedIn: IconBrandLinkedin,
  WhatsApp: IconBrandWhatsapp,
  Telegram: IconBrandTelegram,
  Facebook: IconBrandFacebook,
  Instagram: IconBrandInstagram
} as const;

const marks = [
  { kind: "cross", x: "6%", y: "8%", s: "2.4rem", d: "28s", delay: "-4s" },
  { kind: "cross", x: "86%", y: "16%", s: "3.1rem", d: "36s", delay: "-12s", dir: "reverse" },
  { kind: "cross", x: "14%", y: "74%", s: "2.2rem", d: "32s", delay: "-9s" },
  { kind: "square", x: "90%", y: "7%", s: "2.6rem", d: "30s", delay: "-6s" },
  { kind: "square", x: "4%", y: "40%", s: "3.4rem", d: "40s", delay: "-18s", dir: "reverse" },
  { kind: "square", x: "82%", y: "68%", s: "2.3rem", d: "26s", delay: "-3s" },
  { kind: "circle", x: "18%", y: "18%", s: "2.8rem", d: "34s", delay: "-15s", dir: "reverse" },
  { kind: "circle", x: "93%", y: "46%", s: "2.1rem", d: "24s", delay: "-7s" },
  { kind: "circle", x: "22%", y: "88%", s: "3rem", d: "38s", delay: "-20s" },
  { kind: "triangle", x: "76%", y: "30%", s: "2.7rem", d: "33s", delay: "-11s", dir: "reverse" },
  { kind: "triangle", x: "8%", y: "58%", s: "2.2rem", d: "29s", delay: "-5s" },
  { kind: "triangle", x: "70%", y: "86%", s: "3.2rem", d: "42s", delay: "-16s" }
];
---

<Layout title="Abj - Portfolio" description="My Personal Portfolio">
  <div class="marks" aria-hidden="true">
    {
      marks.map((mark) => (
        <svg
          class="mark"
          style={`--x:${mark.x};--y:${mark.y};--s:${mark.s};--d:${mark.d};--delay:${mark.delay};--dir:${mark.dir ?? "normal"};--ink:${
            mark.kind === "cross"
              ? "#0072ce"
              : mark.kind === "square"
                ? "#e04b8a"
                : mark.kind === "circle"
                  ? "#e10600"
                  : "#00a34a"
          }`}
          viewBox="0 0 48 48"
          fill="none"
          stroke="currentColor"
          stroke-width="2.25"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          {mark.kind === "cross" && <path d="M15 15 L33 33 M33 15 L15 33" />}
          {mark.kind === "square" && <rect x="13" y="13" width="22" height="22" />}
          {mark.kind === "circle" && <circle cx="24" cy="24" r="12" />}
          {mark.kind === "triangle" && <path d="M24 12 L37 35 H11 Z" />}
        </svg>
      ))
    }
  </div>

  <nav class="site-nav" aria-label="On this page" data-page-nav>
    <div class="nav-bar">
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="section-menu" data-nav-toggle>
        <IconMenu2 class="nav-closed" aria-hidden="true" />
        <IconX class="nav-open" aria-hidden="true" />
        <span class="nav-closed">Menu</span>
        <span class="nav-open">Close menu</span>
      </button>
      <button class="theme-switch" type="button" data-theme-toggle>
        <IconMoon class="to-dark" aria-hidden="true" />
        <span class="to-dark">Switch to dark theme</span>
        <IconSun class="to-light" aria-hidden="true" />
        <span class="to-light">Switch to light theme</span>
      </button>
    </div>
    <ul id="section-menu">
      <li><a href="#skills-heading">Skills</a></li>
      <li><a href="#about">About</a></li>
      {profile.posts.length > 0 && <li><a href="#blog">Blog</a></li>}
      <li><a href="#contact">Contact</a></li>
    </ul>
  </nav>

  <article class="sheet">
    <header>
      <h1>{profile.name}</h1>
      <ul class="identity">
        <li>
          <IconCode aria-hidden="true" />
          <span>
            {profile.role} @
            <a href={profile.job.url} target="_blank" rel="noopener noreferrer">{profile.job.name}</a>
          </span>
        </li>
        <li>
          <IconMapPin aria-hidden="true" />
          <span>{profile.location}</span>
        </li>
        <li>
          <IconBallBasketball aria-hidden="true" />
          <span>
            {profile.baskin.label} @
            <a href={profile.baskin.url} target="_blank" rel="noopener noreferrer">{profile.baskin.handle}</a>
          </span>
        </li>
      </ul>

      <section class="github" aria-label="GitHub">
        <p class="github-row">
          <a class="github-link" href={profile.github.url} target="_blank" rel="noopener noreferrer">
            <IconBrandGithub aria-hidden="true" />
            <span>{profile.github.label}</span>
          </a>
        </p>
        {
          columns.length > 0 && (
            <figure class="calendar">
              {range && <figcaption>{range}</figcaption>}
              <div class="graph-scroll">
              <div class="graph" style={`--weeks:${columns.length}`}>
                {columns.flat().map((day) =>
                  day ? (
                    <span class="cell" data-level={day.level} data-label={day.label} />
                  ) : (
                    <span class="cell is-pad" />
                  )
                )}
              </div>
              </div>
              <div class="legend" aria-hidden="true">
                <span>Less</span>
                <span class="cell" data-level="0" />
                <span class="cell" data-level="1" />
                <span class="cell" data-level="2" />
                <span class="cell" data-level="3" />
                <span class="cell" data-level="4" />
                <span>More</span>
              </div>
            </figure>
            <p class="tip" role="tooltip" hidden></p>
          )
        }
        {
          counts.length > 0 && (
            <ul class="counts">
              {counts.map((count) => (
                <li>
                  <strong>{count.value.toLocaleString("en-GB")}</strong>{" "}
                  {count.label}
                </li>
              ))}
            </ul>
          )
        }
      </section>
    </header>

    <main>
      <section class="carousel" data-skill-carousel>
        <h2 id="skills-heading" tabindex="-1">My digital skills</h2>
        <p class="carousel-status" data-skill-status aria-live="polite"></p>
        <div class="carousel-frame">
          <button class="carousel-nav" type="button" data-skill-prev aria-label="Previous skills">
            <IconChevronLeft aria-hidden="true" />
          </button>
          <div class="carousel-stage" aria-labelledby="skills-heading">
            {
              profile.skillGroups.map((group, index) => (
                <section
                  class="skill-group"
                  data-skill-slide
                  aria-roledescription="slide"
                  aria-label={`${index + 1} of ${profile.skillGroups.length}`}
                >
                  <h3>{group.title}</h3>
                  <ul class="skills">
                    {group.items.map((skill) => {
                      const icon = skillIcon(skill);
                      return (
                        <li>
                          {icon ? (
                            <svg class="brand" viewBox="0 0 24 24" aria-hidden="true">
                              <path fill="currentColor" d={icon} />
                            </svg>
                          ) : (
                            <span class="hash" aria-hidden="true">#</span>
                          )}
                          {skill}
                        </li>
                      );
                    })}
                  </ul>
                </section>
              ))
            }
          </div>
          <button class="carousel-nav" type="button" data-skill-next aria-label="Next skills">
            <IconChevronRight aria-hidden="true" />
          </button>
        </div>
      </section>

      <section>
        <h2 id="about" tabindex="-1">About Me</h2>
        <p class="presentation" style="white-space: pre-line;">{profile.about.text}</p>
        <ul class="timeline">
          {profile.about.timeline.map((event) => <li>{event}</li>)}
        </ul>
      </section>

      {
        profile.posts.length > 0 && (
          <section>
            <h2 id="blog" tabindex="-1">Blog</h2>
            <ul class="posts">
              {profile.posts.map((post) => (
                <li>
                  <a href={post.url} target="_blank" rel="noopener noreferrer">
                    <span class="post-still">
                      <img
                        src={post.image}
                        alt=""
                        width="200"
                        height="200"
                        loading="lazy"
                        decoding="async"
                      />
                    </span>
                    <span class="post-copy">
                      <time datetime={post.date}>{postDate(post.date)}</time>
                      <h3>{post.title}</h3>
                      <p>{post.description}</p>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section>
        <h2 id="contact" tabindex="-1">Contact</h2>
        <ul class="contacts">
          {
            profile.contacts.map((contact) => {
              const Icon = contactIcons[contact.title];
              return (
                <li>
                  <a href={contact.href} target="_blank" rel="noopener noreferrer">
                    <Icon aria-hidden="true" />
                    <span class="contact-label">{contact.title}</span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </section>
    </main>

    <footer>
      <p>Copyright © {year}. All rights reserved.</p>
      <p>Developed by {profile.name}</p>
    </footer>
  </article>
</Layout>

<script>
  const tip = document.querySelector(".tip");
  const graph = document.querySelector(".graph");

  if (tip instanceof HTMLElement && graph) {
    const place = (cell: Element) => {
      const label = cell.getAttribute("data-label");
      if (!label) return;
      tip.textContent = label;
      tip.hidden = false;
      const cellBox = cell.getBoundingClientRect();
      const tipBox = tip.getBoundingClientRect();
      const left = Math.min(
        Math.max(8, cellBox.left + cellBox.width / 2 - tipBox.width / 2),
        window.innerWidth - tipBox.width - 8
      );
      let top = cellBox.top - tipBox.height - 8;
      if (top < 8) top = cellBox.bottom + 8;
      tip.style.left = `${left}px`;
      tip.style.top = `${top}px`;
    };

    graph.addEventListener("pointerover", (event) => {
      if (!(event instanceof PointerEvent) || event.pointerType === "touch") return;
      const cell = event.target instanceof Element ? event.target.closest(".cell[data-label]") : null;
      if (cell) place(cell);
      else tip.hidden = true;
    });

    graph.addEventListener("pointerleave", () => {
      tip.hidden = true;
    });

    graph.addEventListener("click", (event) => {
      const cell = event.target instanceof Element ? event.target.closest(".cell[data-label]") : null;
      if (cell) place(cell);
    });
  }

  const carousel = document.querySelector("[data-skill-carousel]");
  if (carousel instanceof HTMLElement) {
    const stage = carousel.querySelector(".carousel-stage");
    const slides = [...carousel.querySelectorAll("[data-skill-slide]")];
    const status = carousel.querySelector("[data-skill-status]");
    const total = slides.length;
    let active = 0;
    let swiped = false;

    const offsetOf = (index: number) => {
      let delta = index - active;
      if (delta > total / 2) delta -= total;
      if (delta < -total / 2) delta += total;
      return delta;
    };

    const render = () => {
      carousel.classList.add("is-ready");
      slides.forEach((slide, index) => {
        if (!(slide instanceof HTMLElement)) return;
        const offset = offsetOf(index);
        slide.dataset.offset = Math.abs(offset) > 1 ? "away" : String(offset);
        slide.setAttribute("aria-hidden", offset === 0 ? "false" : "true");
      });
      const current = slides[active];
      if (stage instanceof HTMLElement) {
        carousel.classList.add("is-measuring");
        let tallest = 0;
        for (const slide of slides) {
          if (slide instanceof HTMLElement) tallest = Math.max(tallest, slide.offsetHeight);
        }
        carousel.classList.remove("is-measuring");
        stage.style.height = `${tallest}px`;
      }
      if (status instanceof HTMLElement && current instanceof HTMLElement) {
        const title = current.querySelector("h3")?.textContent ?? "";
        status.textContent = `${title}, ${active + 1} of ${total}`;
      }
    };

    const go = (step: number) => {
      active = (active + step + total) % total;
      render();
    };

    carousel.querySelector("[data-skill-prev]")?.addEventListener("click", () => go(-1));
    carousel.querySelector("[data-skill-next]")?.addEventListener("click", () => go(1));

    slides.forEach((slide, index) => {
      slide.addEventListener("click", () => {
        if (swiped) return;
        const offset = offsetOf(index);
        if (offset === -1 || offset === 1) go(offset);
      });
    });

    if (stage instanceof HTMLElement) {
      let startX = 0;
      let startY = 0;
      let tracking = false;
      stage.addEventListener("pointerdown", (event) => {
        if (event.pointerType === "mouse" && event.button !== 0) return;
        tracking = true;
        swiped = false;
        startX = event.clientX;
        startY = event.clientY;
      });
      stage.addEventListener("pointerup", (event) => {
        if (!tracking) return;
        tracking = false;
        const dx = event.clientX - startX;
        const dy = event.clientY - startY;
        if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy)) return;
        swiped = true;
        go(dx < 0 ? 1 : -1);
      });
      stage.addEventListener("pointercancel", () => {
        tracking = false;
      });
    }

    carousel.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        go(-1);
      }
      if (event.key === "ArrowRight") {
        event.preventDefault();
        go(1);
      }
    });

    render();
    window.addEventListener("resize", () => render());
    document.fonts?.ready.then(() => render());
    requestAnimationFrame(() => carousel.classList.add("is-animated"));
  }

  const pageNav = document.querySelector("[data-page-nav]");
  const navToggle = pageNav?.querySelector("[data-nav-toggle]");
  const sectionMenu = pageNav?.querySelector("#section-menu");
  const navMobile = matchMedia("(max-width: 720px)");

  if (pageNav instanceof HTMLElement && navToggle instanceof HTMLButtonElement) {
    const closeNav = (returnFocus: boolean) => {
      pageNav.classList.remove("is-open");
      navToggle.setAttribute("aria-expanded", "false");
      if (returnFocus) navToggle.focus();
    };

    navToggle.addEventListener("click", () => {
      const willOpen = navToggle.getAttribute("aria-expanded") !== "true";
      pageNav.classList.toggle("is-open", willOpen);
      navToggle.setAttribute("aria-expanded", String(willOpen));
      if (willOpen) {
        const first = sectionMenu?.querySelector("a");
        if (first instanceof HTMLElement) first.focus();
      }
    });

    sectionMenu?.addEventListener("click", (event) => {
      const link = event.target instanceof Element ? event.target.closest("a") : null;
      if (!(link instanceof HTMLAnchorElement)) return;
      const id = link.getAttribute("href")?.slice(1);
      const target = id ? document.getElementById(id) : null;
      if (!(target instanceof HTMLElement)) return;
      event.preventDefault();
      closeNav(false);
      history.pushState(null, "", link.hash);
      target.scrollIntoView();
      target.focus({ preventScroll: true });
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && pageNav.classList.contains("is-open")) {
        event.preventDefault();
        closeNav(true);
      }
    });

    document.addEventListener("click", (event) => {
      if (!pageNav.classList.contains("is-open")) return;
      if (event.target instanceof Node && pageNav.contains(event.target)) return;
      closeNav(false);
    });

    navMobile.addEventListener("change", () => closeNav(false));
  }
</script>
